			"dest": "_render"
		},
		{
			"src": "^\\/en\\/admissions\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/en\\/boarding\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/en\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/en\\/faq\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/en\\/fees\\/?$",
			"dest": "_render"
