		{
			"src": "^\\/en\\/gallery\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/en\\/news\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/en\\/news\\/?$",
			"dest": "_render"
