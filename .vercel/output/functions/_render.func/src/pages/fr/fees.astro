---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/utils';
import { sanityClient, QUERIES } from '../../lib/sanity';

const lang = 'fr';
const t = useTranslation(lang);

let courses: any[] = [];
try {
  courses = await sanityClient.fetch(QUERIES.allCourses);
} catch (_) {}

const paystackKey = import.meta.env.PUBLIC_PAYSTACK_KEY;

const feeTable = t.fees.static_fee_table as Array<{
  level: string; ages: string; duration: string; fee: string;
}>;
const included = t.fees.what_included as string[];
---

<BaseLayout lang={lang} title={t.fees.title} description={t.fees.subtitle}>
  <div class="bg-navy-700 text-white py-16 relative overflow-hidden -mt-16 pt-28">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, #f0a500 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block text-gold font-semibold text-sm uppercase tracking-widest mb-3">Par Trimestre · 3 Trimestres / An</span>
      <h1 class="text-4xl md:text-5xl font-heading font-bold">{t.fees.title}</h1>
      <p class="text-gray-300 mt-3 text-lg max-w-2xl">{t.fees.subtitle}</p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <div class="flex items-start gap-3 bg-blue-50 border border-blue-200 rounded-xl px-5 py-4 text-sm text-blue-900">
      <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <div>
        <p class="font-semibold mb-1">Comment fonctionnent nos frais</p>
        <p>{t.fees.terms_note}</p>
      </div>
    </div>

    <section>
      <h2 class="text-2xl font-heading font-bold text-navy mb-6">{t.fees.table_program}</h2>

      {courses.length > 0 ? (
        <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
          <table class="w-full text-sm">
            <thead class="bg-navy-700 text-white">
              <tr>
                <th class="text-left px-6 py-4 font-semibold">{t.fees.table_program}</th>
                <th class="text-left px-6 py-4 font-semibold">{t.fees.table_duration}</th>
                <th class="text-left px-6 py-4 font-semibold">{t.fees.table_fee}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {courses.map((c: any, i: number) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                  <td class="px-6 py-4 font-medium text-navy">{c.titleFr || c.titleEn}</td>
                  <td class="px-6 py-4 text-gray-600">{c.duration || ''}</td>
                  <td class="px-6 py-4 text-gold font-semibold">{c.fees || t.fees.contact_for_pricing}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
          <table class="w-full text-sm">
            <thead class="bg-navy-700 text-white">
              <tr>
                <th class="text-left px-6 py-4 font-semibold">Niveau</th>
                <th class="text-left px-6 py-4 font-semibold">Âges</th>
                <th class="text-left px-6 py-4 font-semibold">Durée</th>
                <th class="text-left px-6 py-4 font-semibold">{t.fees.table_fee}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {feeTable.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-white hover:bg-gold/5' : 'bg-gray-50 hover:bg-gold/5'} style="transition: background 0.2s">
                  <td class="px-6 py-4 font-semibold text-navy">{row.level}</td>
                  <td class="px-6 py-4 text-gray-600">{row.ages}</td>
                  <td class="px-6 py-4 text-gray-600">{row.duration}</td>
                  <td class="px-6 py-4">
                    <a href={`/${lang}/contact`} class="text-gold hover:underline text-sm font-semibold">{t.fees.contact_for_pricing}</a>
                  </td>
                </tr>
              ))}
              <tr class="bg-navy-700/5 border-t-2 border-navy-700/20">
                <td class="px-6 py-4 font-semibold text-navy" colspan="3">{t.fees.boarding_row_label}</td>
                <td class="px-6 py-4">
                  <a href={`/${lang}/contact`} class="text-gold hover:underline text-sm font-semibold">{t.fees.boarding_row_fee}</a>
                </td>
              </tr>
              <tr class="bg-gray-50">
                <td class="px-6 py-4 font-semibold text-navy" colspan="3">{t.fees.registration_fee_label}</td>
                <td class="px-6 py-4">
                  <a href={`/${lang}/contact`} class="text-gold hover:underline text-sm font-semibold">{t.fees.registration_fee_value}</a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      )}

      <div class="mt-4 flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-xl px-5 py-4 text-sm text-amber-900">
        <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <span>{t.fees.boarding_fee_note}</span>
      </div>
    </section>

    <section class="reveal">
      <h2 class="text-2xl font-heading font-bold text-navy mb-6">{t.fees.what_included_title}</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {included.map((item: string) => (
          <div class="flex items-start gap-3 bg-white rounded-xl border border-gray-100 shadow-sm p-4">
            <div class="w-8 h-8 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <p class="text-sm text-gray-700 leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="reveal">
      <h2 class="text-2xl font-heading font-bold text-navy mb-2">{t.fees.payment_title}</h2>
      <p class="text-gray-600 mb-8">{t.fees.payment_subtitle}</p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="font-heading font-bold text-navy">{t.fees.mobile_money_title}</h3>
          </div>
          <ul class="space-y-2">
            {(t.fees.mobile_money_networks as string[]).map((network) => (
              <li class="flex items-center gap-2 text-sm text-gray-700">
                <span class="w-2 h-2 rounded-full bg-gold flex-shrink-0"></span>
                {network}
              </li>
            ))}
          </ul>
          <p class="text-xs text-gray-500 mt-4">Référence de paiement fournie à la confirmation d'inscription.</p>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-navy-700/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
            </div>
            <h3 class="font-heading font-bold text-navy">{t.fees.bank_title}</h3>
          </div>
          <p class="text-sm text-gray-500 italic">{t.fees.bank_placeholder}</p>
        </div>
      </div>
    </section>

    {paystackKey && (
      <section class="reveal text-center">
        <button id="paystack-btn" type="button" class="btn-primary text-base px-10 py-4">
          {t.fees.paystack_button}
        </button>
        <script define:vars={{ paystackKey }}>
          document.getElementById('paystack-btn')?.addEventListener('click', () => {
            const handler = PaystackPop.setup({
              key: paystackKey,
              email: 'student@example.com',
              amount: 0,
              currency: 'GHS',
              callback: (response) => { alert('Paiement réussi ! Référence : ' + response.reference); },
              onClose: () => {},
            });
            handler.openIframe();
          });
        </script>
        <script src="https://js.paystack.co/v1/inline.js" defer></script>
      </section>
    )}

    <section class="reveal bg-navy-700 rounded-3xl p-10 text-white text-center">
      <h2 class="text-2xl font-heading font-bold mb-3">Une question sur les frais ?</h2>
      <p class="text-gray-300 mb-7 max-w-md mx-auto">Notre équipe des admissions est disponible pour vous expliquer la structure des frais, les modalités de paiement et les bourses disponibles.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`/${lang}/contact`} class="btn-primary">Contacter les Admissions</a>
        <a href={`/${lang}/admissions`} class="btn-secondary">Postuler à l'Inscription</a>
      </div>
    </section>
  </div>
</BaseLayout>
