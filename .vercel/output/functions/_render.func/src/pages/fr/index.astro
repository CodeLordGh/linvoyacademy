---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/utils';
import { sanityClient, QUERIES } from '../../lib/sanity';

const lang = 'fr';
const t = useTranslation(lang);

let testimonials: any[] = [];
let newsPosts:    any[] = [];
let partners:     any[] = [];
let settings:     any   = null;

try {
  [testimonials, newsPosts, partners, settings] = await Promise.all([
    sanityClient.fetch(QUERIES.latestTestimonials),
    sanityClient.fetch(QUERIES.latestNews),
    sanityClient.fetch(QUERIES.allPartners),
    sanityClient.fetch(QUERIES.siteSettings),
  ]);
} catch (err) {
  console.error('[fr/index] Sanity fetch error:', err);
}

const programCards = [
  {
    title: t.programs_overview.languages.title,
    description: t.programs_overview.languages.description,
    icon: 'M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129',
    color: 'from-blue-500 to-navy-700',
    bg: 'bg-blue-50',
  },
  {
    title: t.programs_overview.business.title,
    description: t.programs_overview.business.description,
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    color: 'from-gold to-yellow-400',
    bg: 'bg-yellow-50',
  },
  {
    title: t.programs_overview.computing.title,
    description: t.programs_overview.computing.description,
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    color: 'from-emerald-500 to-teal-600',
    bg: 'bg-emerald-50',
  },
  {
    title: t.programs_overview.security.title,
    description: t.programs_overview.security.description,
    icon: 'M15 10l4.553-2.069A1 1 0 0121 8.87V15.13a1 1 0 01-1.447.9L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z',
    color: 'from-rose-500 to-pink-600',
    bg: 'bg-rose-50',
  },
];

const whyCards = [
  { title: t.why_linvoy.holistic.title,  description: t.why_linvoy.holistic.description,  icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' },
  { title: t.why_linvoy.inclusive.title, description: t.why_linvoy.inclusive.description, icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { title: t.why_linvoy.bilingual.title, description: t.why_linvoy.bilingual.description, icon: 'M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129' },
  { title: t.why_linvoy.boarding.title,  description: t.why_linvoy.boarding.description,  icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { title: t.why_linvoy.cctv.title,      description: t.why_linvoy.cctv.description,      icon: 'M15 10l4.553-2.069A1 1 0 0121 8.87V15.13a1 1 0 01-1.447.9L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z' },
];

const heroStats = [
  { value: settings?.totalStudents    ? String(settings.totalStudents)    : '', label: 'Élèves Inscrits' },
  { value: settings?.totalParents     ? String(settings.totalParents)     : '', label: 'Familles Nous Font Confiance' },
  { value: settings?.yearsOperating   ? `${settings.yearsOperating}+`     : '', label: "Années d'Excellence" },
  { value: settings?.boardingCapacity ? String(settings.boardingCapacity) : '', label: 'Places en Internat' },
];
---

<BaseLayout lang={lang} title="Accueil" description={t.hero.subheadline}>

  <!-- Hero -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden -mt-16">
    <div class="absolute inset-0">
      <img src="/images/hero.jpg" alt="" role="presentation"
           class="w-full h-full object-cover object-center" fetchpriority="high" />
      <div class="hero-overlay absolute inset-0"></div>
      <div class="absolute inset-0 opacity-10"
           style="background-image: linear-gradient(rgba(240,165,0,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(240,165,0,0.4) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>
    <div class="absolute top-20 right-10 w-72 h-72 rounded-full bg-gold/10 blur-3xl animate-float pointer-events-none"></div>
    <div class="absolute bottom-20 left-10 w-56 h-56 rounded-full bg-blue-400/10 blur-3xl animate-float delay-300 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-36 md:pb-32 w-full">
      <div class="max-w-3xl">
        <div class="animate-fade-up inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 text-sm font-medium px-4 py-2 rounded-full mb-8">
          <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
          Accra, Ghana · École d'Éducation de Base Holistique avec Internat
        </div>
        <h1 class="animate-fade-up delay-100 text-5xl md:text-7xl font-heading font-bold text-white leading-[1.1] mb-6">
          {t.hero.headline.split(' ').slice(0, 4).join(' ')}<br />
          <span class="text-gold-premium">{t.hero.headline.split(' ').slice(4).join(' ')}</span>
        </h1>
        <p class="animate-fade-up delay-200 text-lg md:text-xl text-gray-300 max-w-xl leading-relaxed mb-10">
          {t.hero.subheadline}
        </p>
        <div class="animate-fade-up delay-300 flex flex-col sm:flex-row gap-4">
          <a href={`/${lang}/programs`} class="btn-secondary text-base">
            {t.hero.cta_programs}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href={`/${lang}/admissions`} class="btn-primary text-base">{t.hero.cta_register}</a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 inset-x-0 bg-black/30 backdrop-blur-sm border-t border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-white/10">
          {heroStats.map((s, i) => (
            <div class={`py-4 px-4 text-center animate-fade-up delay-${(i + 3) * 100}`}>
              <div class="stat-number text-2xl font-heading font-bold text-gold">{s.value}</div>
              <div class="text-xs text-gray-400 mt-0.5">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <a href="#programs" aria-label="Défiler vers le bas"
       class="absolute bottom-20 right-8 hidden md:flex w-10 h-10 rounded-full border border-white/30 items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-colors animate-bounce">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </a>
  </section>

  <!-- Programs Overview -->
  <section id="programs" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 reveal">
        <span class="inline-block text-gold font-semibold text-sm uppercase tracking-widest mb-3">Ce que nous offrons</span>
        <h2 class="section-title">{t.programs_overview.title}</h2>
        <p class="section-subtitle mx-auto">{t.programs_overview.subtitle}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {programCards.map((card, i) => (
          <div class="reveal group relative bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-400 overflow-hidden"
               data-delay={i * 100}>
            <div class={`absolute top-0 inset-x-0 h-1 bg-gradient-to-r ${card.color}`}></div>
            <div class={`w-14 h-14 rounded-2xl ${card.bg} flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300`}>
              <svg class="w-7 h-7 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={card.icon} />
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-navy mb-3">{card.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-6">{card.description}</p>
            <a href={`/${lang}/programs`} class="inline-flex items-center gap-1.5 text-gold font-semibold text-sm group-hover:gap-3 transition-all">
              En savoir plus
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trusted by strip -->
  {(settings?.totalStudents || settings?.totalParents || settings?.yearsOperating) && (
    <section class="py-16 bg-cream border-y border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10 reveal">
          <span class="inline-block text-gold font-semibold text-sm uppercase tracking-widest mb-2">En Chiffres</span>
          <h2 class="text-2xl font-heading font-bold text-navy">La Confiance des Familles du Ghana</h2>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {heroStats.filter(s => s.value !== '').map((s, i) => (
            <div class="reveal bg-white rounded-2xl p-6 text-center shadow-sm border border-gray-100 group hover:border-gold/40 hover:shadow-lg transition-all duration-300"
                 data-delay={i * 80}>
              <div class="text-4xl font-heading font-bold text-navy mb-1 group-hover:text-gold transition-colors js-counter"
                   data-target={s.value.replace('+', '').replace('', '0')}
                   data-suffix={s.value.includes('+') ? '+' : ''}>
                {s.value}
              </div>
              <div class="text-sm text-gray-500">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Why Linvoy -->
  <section class="py-24 bg-navy-700 relative overflow-hidden">
    <div class="absolute -top-20 -right-20 w-96 h-96 rounded-full bg-white/5 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-96 h-96 rounded-full bg-gold/5 blur-3xl pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 reveal">
        <span class="inline-block text-gold font-semibold text-sm uppercase tracking-widest mb-3">Pourquoi nous choisir</span>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4">{t.why_linvoy.title}</h2>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">{t.why_linvoy.subtitle}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyCards.map((card, i) => (
          <div class="reveal group relative bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl p-7 hover:bg-white/10 hover:border-gold/40 transition-all duration-300"
               data-delay={i * 100}>
            <span class="absolute top-4 right-5 text-6xl font-heading font-bold text-white/5 group-hover:text-gold/10 transition-colors select-none">0{i + 1}</span>
            <div class="w-12 h-12 rounded-xl bg-gold/20 flex items-center justify-center mb-5 group-hover:bg-gold/30 transition-colors">
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={card.icon} />
              </svg>
            </div>
            <h3 class="font-heading font-bold text-white mb-2">{card.title}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  {partners.length > 0 && (
    <section class="py-16 bg-white border-b border-gray-100 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10 reveal">
        <span class="inline-block text-gold font-semibold text-sm uppercase tracking-widest mb-2">Partenaires & Accréditations</span>
        <h2 class="text-2xl font-heading font-bold text-navy">Reconnu et Soutenu Par</h2>
      </div>

      {partners.length <= 4 ? (
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-center justify-center gap-12">
            {partners.map((p: any) => (
              <div class="flex items-center justify-center">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer"
                     aria-label={p.name}
                     class="block transition-all duration-300 hover:scale-105 hover:opacity-100 opacity-75">
                    <img src={`${p.logoUrl}?w=240&fm=webp`} alt={p.name}
                         class="h-20 w-auto object-contain max-w-[180px]" loading="lazy" />
                  </a>
                ) : (
                  <img src={`${p.logoUrl}?w=240&fm=webp`} alt={p.name}
                       class="h-20 w-auto object-contain max-w-[180px] opacity-75" loading="lazy" />
                )}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="relative"
             style="mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);">
          <div class="flex animate-marquee">
            {[...partners, ...partners].map((p: any, i: number) => (
              <div class="flex-shrink-0 mx-10 flex items-center justify-center">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer"
                     aria-label={p.name}
                     class="block transition-all duration-300 hover:scale-105 hover:opacity-100 opacity-70">
                    <img src={`${p.logoUrl}?w=240&fm=webp`} alt={p.name}
                         class="h-20 w-auto object-contain max-w-[180px]" loading="lazy" />
                  </a>
                ) : (
                  <img src={`${p.logoUrl}?w=240&fm=webp`} alt={p.name}
                       class="h-20 w-auto object-contain max-w-[180px] opacity-70" loading="lazy" />
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="py-24 bg-cream">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14 reveal">
          <span class="inline-block text-gold font-semibold text-sm uppercase tracking-widest mb-3">Témoignages</span>
          <h2 class="section-title">{t.testimonials_preview.title}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {testimonials.map((item: any, i: number) => (
            <div class="reveal relative bg-white rounded-3xl p-8 shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300"
                 data-delay={i * 120}>
              <svg class="absolute top-6 right-8 w-12 h-12 text-gold/15" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
              <p class="text-gray-700 text-base leading-relaxed italic mb-6">"{item.quoteFr || item.quoteEn}"</p>
              <div class="flex items-center gap-4 pt-5 border-t border-gray-100">
                {item.photoUrl ? (
                  <img src={`${item.photoUrl}?w=80&fm=webp`} alt={item.reviewerName}
                       class="w-12 h-12 rounded-full object-cover ring-2 ring-gold/40" />
                ) : (
                  <div class="w-12 h-12 rounded-full bg-navy-700 flex items-center justify-center text-white font-bold text-lg">
                    {(item.reviewerName ?? '?')[0]}
                  </div>
                )}
                <div>
                  <div class="font-semibold text-navy">{item.reviewerName}</div>
                  <div class="text-gold text-sm">
                    {item.reviewerType === 'parent' ? 'Parent' : item.reviewerType === 'alumni' ? 'Ancien élève' : 'Élève'}
                    {item.program && ` · ${item.program}`}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="text-center mt-12">
          <a href={`/${lang}/testimonials`} class="btn-outline">
            {t.testimonials_preview.view_all}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- News -->
  {newsPosts.length > 0 && (
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-14 reveal">
          <div>
            <span class="inline-block text-gold font-semibold text-sm uppercase tracking-widest mb-3">Dernières nouvelles</span>
            <h2 class="section-title mb-0">{t.news_preview.title}</h2>
          </div>
          <a href={`/${lang}/news`} class="mt-4 sm:mt-0 text-navy font-semibold text-sm hover:text-gold transition-colors inline-flex items-center gap-1.5">
            {t.news_preview.view_all}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {newsPosts.map((post: any, i: number) => (
            <article class="reveal card group" data-delay={i * 100}>
              <div class="aspect-video overflow-hidden bg-gray-100">
                {post.imageUrl ? (
                  <img src={`${post.imageUrl}?w=600&fm=webp`} alt={post.title}
                       class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-navy-700 to-navy-800 flex items-center justify-center">
                    <svg class="w-10 h-10 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                )}
              </div>
              <div class="p-6">
                <time class="text-xs text-gray-400 mb-3 block">
                  {new Date(post.publishedAt).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <h3 class="font-heading font-bold text-navy text-base mb-2 line-clamp-2 group-hover:text-gold transition-colors">{post.title}</h3>
                {post.excerpt && <p class="text-gray-500 text-sm line-clamp-2 mb-4">{post.excerpt}</p>}
                <a href={`/${lang}/news/${post.slug?.current}`} class="inline-flex items-center gap-1 text-gold font-semibold text-sm group-hover:gap-2.5 transition-all">
                  {t.news.read_more}
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Banner -->
  <section class="relative py-24 bg-gold overflow-hidden">
    <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-yellow-300/30 pointer-events-none"></div>
    <div class="absolute -bottom-16 -left-16 w-64 h-64 rounded-full bg-orange-400/20 pointer-events-none"></div>
    <div class="absolute inset-0 opacity-5"
         style="background-image: radial-gradient(circle, #1a2e6e 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative max-w-4xl mx-auto px-4 text-center reveal">
      <span class="inline-block bg-navy/10 text-navy font-semibold text-sm uppercase tracking-widest px-4 py-1.5 rounded-full mb-6">
        Inscriptions Ouvertes
      </span>
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-navy mb-5 leading-tight">{t.cta_banner.headline}</h2>
      <p class="text-navy/70 text-lg mb-10 max-w-xl mx-auto">{t.cta_banner.subheadline}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`/${lang}/admissions`}
           class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-navy text-white font-bold rounded-xl hover:bg-navy-800 active:scale-95 transition-all text-base shadow-2xl shadow-navy/30">
          {t.cta_banner.button}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={`/${lang}/contact`}
           class="inline-flex items-center justify-center gap-2 px-10 py-4 border-2 border-navy text-navy font-bold rounded-xl hover:bg-navy hover:text-white active:scale-95 transition-all text-base">
          {t.cta_banner.secondary}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el    = entry.target as HTMLElement;
      const delay = parseInt(el.dataset.delay || '0', 10);
      setTimeout(() => { el.classList.add('visible'); revealObs.unobserve(el); }, delay);
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach((el) => revealObs.observe(el));

  function animateCounter(el: HTMLElement) {
    const target  = parseInt(el.dataset.target || '0', 10);
    const suffix  = el.dataset.suffix || '';
    if (!target) return;
    const duration = 1800;
    const step = 16;
    const increment = target / (duration / step);
    let current = 0;
    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        clearInterval(timer);
        el.textContent = target.toLocaleString() + suffix;
      } else {
        el.textContent = Math.floor(current).toLocaleString() + suffix;
      }
    }, step);
  }

  const counterObs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      counterObs.unobserve(entry.target);
      animateCounter(entry.target as HTMLElement);
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.js-counter').forEach((el) => counterObs.observe(el));
</script>
