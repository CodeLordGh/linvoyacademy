---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/utils';
import { sanityClient, QUERIES } from '../../lib/sanity';
import RegistrationForm from '../../components/RegistrationForm';

const lang = 'en';
const t = useTranslation(lang);

let courses: any[] = [];
try {
  courses = await sanityClient.fetch(QUERIES.allCourses);
} catch (_) {}
---

<BaseLayout lang={lang} title={t.admissions.title} description={t.admissions.subtitle}>
  <div class="bg-navy-700 text-white py-16 -mt-16 pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-heading font-bold">{t.admissions.title}</h1>
      <p class="text-gray-300 mt-3 text-lg max-w-2xl">{t.admissions.subtitle}</p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-5 gap-12">
      <!-- Entry Requirements sidebar -->
      <aside class="lg:col-span-2">
        <div class="bg-cream rounded-xl p-6 sticky top-24">
          <h2 class="text-xl font-heading font-bold text-navy mb-4">{t.admissions.requirements_title}</h2>
          <ul class="space-y-3">
            {t.admissions.requirements.map((req) => (
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <svg class="w-5 h-5 text-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                {req}
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <!-- Registration Form -->
      <div class="lg:col-span-3">
        <RegistrationForm
          client:load
          lang={lang}
          courses={courses}
          t={t.admissions}
        />
      </div>
    </div>
  </div>
</BaseLayout>
