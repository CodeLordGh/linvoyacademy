---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/utils';
import { sanityClient, QUERIES } from '../../lib/sanity';

const lang = 'en';
const t = useTranslation(lang);

let testimonials: any[] = [];
try {
  testimonials = await sanityClient.fetch(QUERIES.allTestimonials);
} catch (_) {}
---

<BaseLayout lang={lang} title={t.testimonials.title} description={t.testimonials.subtitle}>
  <div class="bg-navy-700 text-white py-16 -mt-16 pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-heading font-bold">{t.testimonials.title}</h1>
      <p class="text-gray-300 mt-3 text-lg">{t.testimonials.subtitle}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    {testimonials.length === 0 ? (
      <p class="text-gray-500 text-center py-20">{t.testimonials.no_testimonials}</p>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {testimonials.map((item: any) => (
          <div class="card p-6 flex flex-col reveal">
            <svg class="w-8 h-8 text-gold/40 mb-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <p class="text-gray-700 italic leading-relaxed flex-1 mb-5">"{item.quoteEn}"</p>
            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
              {item.photoUrl ? (
                <img src={`${item.photoUrl}?w=80&fm=webp`} alt={item.reviewerName}
                     class="w-10 h-10 rounded-full object-cover ring-2 ring-gold/30" loading="lazy" />
              ) : (
                <div class="w-10 h-10 rounded-full bg-navy-700/10 flex items-center justify-center text-navy font-bold">
                  {item.reviewerName?.[0] || '?'}
                </div>
              )}
              <div>
                <div class="font-semibold text-navy text-sm">{item.reviewerName}</div>
                <div class="text-gold text-xs">
                  {item.reviewerType === 'parent' ? 'Parent' : item.reviewerType === 'alumni' ? 'Alumni' : 'Student'}
                  {item.program && ` · ${item.program}`}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
