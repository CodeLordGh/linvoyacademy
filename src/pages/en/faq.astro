---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/utils';
import { sanityClient, QUERIES } from '../../lib/sanity';
import Accordion from '../../components/Accordion';

const lang = 'en';
const t = useTranslation(lang);

let faqs: any[] = [];
try {
  faqs = await sanityClient.fetch(QUERIES.allFaqs);
} catch (_) {}
---

<BaseLayout lang={lang} title={t.faq.title} description={t.faq.subtitle}>
  <div class="bg-navy-700 text-white py-16 -mt-16 pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-heading font-bold">{t.faq.title}</h1>
      <p class="text-gray-300 mt-3 text-lg">{t.faq.subtitle}</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    {faqs.length === 0 ? (
      <p class="text-gray-500 text-center py-20">{t.faq.no_items}</p>
    ) : (
      <Accordion client:visible items={faqs} lang={lang} />
    )}

    <div class="mt-12 p-6 bg-cream rounded-xl text-center">
      <p class="text-gray-700 mb-3">{t.faq.contact_cta}</p>
      <a href={`/${lang}/contact`} class="btn-outline">{t.faq.contact_link}</a>
    </div>
  </div>
</BaseLayout>
